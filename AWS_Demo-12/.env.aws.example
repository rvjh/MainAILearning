# AWS deployment variables — copy to .env.aws and fill in before class.
# Requires: AWS CLI configured (aws sts get-caller-identity)

AWS_REGION=us-east-1
STACK_NAME=aws-agent-deployment-demo
PROJECT_NAME=aws-agent-deployment-demo

# Optional overrides (auto-detected from default VPC if unset)
# VPC_ID=vpc-xxxxxxxx
# SUBNET_IDS=subnet-aaa,subnet-bbb

IMAGE_TAG=latest
API_SERVICE_NAME=aws-agent-deployment-demo-api
WORKER_SERVICE_NAME=aws-agent-deployment-demo-worker
