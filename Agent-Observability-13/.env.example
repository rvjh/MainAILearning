# Optional — demos run deterministically without these; set for live APIs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LangSmith: set the key; tracing turns on automatically unless set to false.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=july-cohort-observability

# Teaching knobs
ALLOW_DEMO_FAULTS=true
OBS_AGENT_VERSION=support-ops-v1
OBS_PROMPT_VERSION=support-prompt-v3
OBS_DEPLOYMENT_VERSION=local-demo-1
COST_INPUT_USD_PER_1M=0.15
COST_OUTPUT_USD_PER_1M=0.60
